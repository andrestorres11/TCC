# Supabase Cloud — copia este archivo a .env.local y complétalo con las llaves
# de tu proyecto (Project Settings → API). NO subas .env.local a git.

# Project URL (p. ej. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (pública, va al navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA — solo servidor: ingesta, detección y seed)
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido para los endpoints /api/ingest/* y /api/detection/run
INGEST_SECRET=cambia-este-secreto

# Minutos sin resolver tras los que una parada pendiente genera alerta
DETECTION_THRESHOLD_MINUTES=45
